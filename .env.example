BUSYBAR_ADDR=
BUSYBAR_TOKEN=
BUSYBAR_PRIORITY=60
# Discord source: user-token (default), bot, or rpc.
DISCORD_MODE=user-token
# Bot mode: your user ID, not the bot's ID (Discord Developer Mode -> Copy User ID).
DISCORD_USER_ID=
# RPC mode: developer application credentials. Run on the same PC as Discord.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Enter tokens with: uv run busydiscord --mode user-token --login
# or: uv run busydiscord --mode bot --login
# RPC authorization: uv run busydiscord --mode rpc --login
# Each mode stores its own authorization in .state/.
